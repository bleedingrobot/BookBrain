# Copy to .env and fill in. Never commit the real .env.

DATABASE_URL=sqlite+aiosqlite:///./epub_librarian.db

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Encryption key for tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# See https://console.anthropic.com/ for an API key.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

GOOGLE_BOOKS_API_KEY=

# CORS origin for the Vite dev server
FRONTEND_ORIGIN=http://localhost:5173
