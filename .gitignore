/epub_librarian.db-journal
/epub_librarian.db-shm
/epub_librarian.db-wal

# Torrent subsystem — secrets and runtime data, not the compose file itself
docker/.env
torrents/

# Node / frontend
node_modules/
dist/

# Dashboard runtime
dashboard/mobile/status.json
# Alert transitions, appended by dashboard.sh (prompts/45). Runtime state,
# self-truncating, and meaningful only on the box that wrote it.
dashboard/alerts.log
dashboard/.alerts-state
dashboard/.alerts-state.lock

